# Local PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://replace-user:replace-password@localhost:5433/toktickit?schema=public"

# Docker Compose database settings. Copy this file to .env and replace values.
POSTGRES_USER="replace-user"
POSTGRES_PASSWORD="replace-password"
POSTGRES_DB="toktickit"

# Optional browser-to-API override. Leave empty to use the Vite /api proxy.
VITE_API_BASE_URL=""
